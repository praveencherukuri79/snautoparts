# ==============================================================================
# SN Auto Parts Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]
# ==============================================================================

# ------------------------------------------------------------------------------
# Node Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration [REQUIRED]
# ------------------------------------------------------------------------------
# Database type: postgresql or mssql
DB_TYPE=postgresql

# Cloud PostgreSQL (e.g., Supabase, Neon, Railway, etc.)
DB_HOST=ep-muddy-block-ah2t53no-pooler.c-3.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=SNAUTOPARTS
DB_USER=neondb_owner
DB_PASSWORD=npg_cmna8L4eHEJZ


# Constructed DATABASE_URL (used by Better Auth internally):
# postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB_NAME}
# Example: postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# For SQL Server (Azure SQL, etc.):
# DB_TYPE=mssql
# DB_HOST=your-server.database.windows.net
# DB_PORT=1433
# DB_NAME=snautoparts
# DB_USER=your-username
# DB_PASS=your-password

# ------------------------------------------------------------------------------
# Authentication (Better Auth) [REQUIRED]
# ------------------------------------------------------------------------------
# Secret key for signing tokens (min 32 characters)
BETTER_AUTH_SECRET=your-super-secret-key-at-least-32-characters-long

# Backend URL (where the API is hosted)
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Frontend URL (for CORS)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:4200

# ------------------------------------------------------------------------------
# Stripe Payments (Optional - mock mode if not configured)
# ------------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# Email (Resend) (Optional - mock mode if not configured)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@snautoparts.com

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Feature Configuration
# ------------------------------------------------------------------------------
# Cache TTL for role-based feature configs (in seconds)
FEATURE_CONFIG_CACHE_TTL=300

# ------------------------------------------------------------------------------
# Job Queue (Optional - for background processing)
# ------------------------------------------------------------------------------
JOB_QUEUE_REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Outgoing Webhooks
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=your-webhook-signing-secret

# ------------------------------------------------------------------------------
# Supplier Integrations (Optional - for drop-shipping)
# ------------------------------------------------------------------------------
# A-Premium
APREMIUM_API_URL=https://api.apremiumautoparts.com
APREMIUM_API_KEY=your-api-key
APREMIUM_TIMEOUT_MS=8000

# BuyAutoParts
BUYAUTOPARTS_API_URL=https://api.buyautoparts.com
BUYAUTOPARTS_API_KEY=your-api-key
BUYAUTOPARTS_TIMEOUT_MS=8000

# TRQ
TRQ_API_URL=https://api.trqauto.com
TRQ_API_KEY=your-api-key
TRQ_TIMEOUT_MS=8000