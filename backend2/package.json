{
  "name": "snautoparts-backend",
  "version": "1.0.0",
  "description": "SN Auto Parts Backend API - Fastify + MikroORM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "kill-port 3000 && tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "migration:create": "mikro-orm migration:create",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down",
    "schema:fresh": "mikro-orm schema:fresh --run",
    "seeder:run": "mikro-orm seeder:run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/passport": "^2.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/secure-session": "^7.5.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@mikro-orm/core": "^6.1.0",
    "@mikro-orm/migrations": "^6.1.0",
    "@mikro-orm/mssql": "^6.1.0",
    "@mikro-orm/postgresql": "^6.1.0",
    "@mikro-orm/reflection": "^6.6.3",
    "@mikro-orm/seeder": "^6.1.0",
    "bcrypt": "^6.0.0",
    "fastify": "^4.25.2",
    "fastify-plugin": "^4.5.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "resend": "^2.1.0",
    "stripe": "^14.11.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.4"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.10.6",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^9.0.7",
    "nock": "^13.5.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
