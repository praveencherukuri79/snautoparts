{
  "name": "snautoparts-backend",
  "version": "1.0.0",
  "description": "SN Auto Parts E-Commerce Backend - Fastify + Prisma + Postgres",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "node scripts/prisma-env.js generate",
    "db:push": "node scripts/prisma-env.js db push",
    "db:migrate": "node scripts/prisma-env.js migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma-env.js studio"
  },
  "dependencies": {
    "@fastify/cookie": "^9.2.0",
    "@fastify/cors": "^8.4.1",
    "@fastify/formbody": "^7.4.0",
    "@fastify/multipart": "^8.0.0",
    "@fastify/sensible": "^5.6.0",
    "@prisma/client": "^5.7.0",
    "@stripe/stripe-js": "^2.2.0",
    "better-auth": "^1.0.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.0",
    "fastify-plugin": "^4.5.1",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "resend": "^2.0.0",
    "stripe": "^14.8.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "prisma": "^5.7.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
